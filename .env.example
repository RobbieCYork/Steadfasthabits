# Copy this file to .env.local and fill in your Supabase project's values.
# Find them in the Supabase dashboard: Project -> Settings -> API.
# The anon/public key is safe to expose in client-side code — it only grants
# what your Row Level Security policies (see supabase/schema.sql) allow.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
